{
  "name": "orkiva",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "orkiva",
      "version": "1.0.0",
      "workspaces": [
        "services/*",
        "packages/*"
      ]
    },
    "node_modules/@orkiva/api-gateway": {
      "resolved": "services/api-gateway",
      "link": true
    },
    "node_modules/@orkiva/shared-contracts": {
      "resolved": "packages/shared-contracts",
      "link": true
    },
    "packages/shared-contracts": {
      "name": "@orkiva/shared-contracts",
      "version": "1.0.0"
    },
    "services/api-gateway": {
      "name": "@orkiva/api-gateway",
      "version": "1.0.0"
    }
  }
}
